# Generate independent random secrets with at least 32 characters for DASHBOARD_ACCESS_TOKEN,
# PUBLIC_ORDER_FORM_TOKEN, SURVEY_SIGNING_SECRET, ZAPI_WEBHOOK_SECRET and CRON_SECRET.
# Use URL-safe characters for ZAPI_WEBHOOK_SECRET. Keep Z-API provider credentials as issued.
# These values belong in Vercel Project Settings > Environment Variables.
# For local use, copy this file to .env.local and fill it locally.
SUPABASE_URL=https://ztwrqyvamsgzrpidhide.supabase.co
# The standalone sector portal uses Supabase Auth. SUPABASE_PUBLIC_KEY and
# SUPABASE_ANON_KEY are also accepted aliases. All values stay server-side.
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SECTOR_SESSION_SECRET=generate-a-separate-random-secret-with-at-least-32-characters
SECTOR_MANAGER_BOOTSTRAP_TOKEN=generate-a-one-time-manager-setup-token-with-at-least-32-characters
SECTOR_PORTAL_ENABLED=false
DASHBOARD_ACCESS_TOKEN=generate-a-long-random-token
APP_BASE_URL=https://your-dashboard-domain.vercel.app
ZAPI_INSTANCE_ID=replace-with-z-api-instance-id
ZAPI_INSTANCE_TOKEN=replace-with-z-api-instance-token
ZAPI_CLIENT_TOKEN=replace-with-z-api-account-client-token
ZAPI_WEBHOOK_SECRET=generate-a-separate-random-path-secret
PUBLIC_ORDER_FORM_TOKEN=generate-a-separate-random-form-token
SURVEY_SIGNING_SECRET=generate-at-least-32-random-characters
CRON_SECRET=generate-a-separate-random-cron-token

